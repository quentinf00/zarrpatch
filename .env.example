# Copy to .env (gitignored) and adapt. pixi sources it on activation and the
# benchmark scripts read it (benchmarks/_env.py).

# Scratch space for benchmark outputs (each benchmark uses its own subdir).
ZARRPATCH_SCRATCH=/path/to/scratch/zarrpatch

# Root for the synthetic stores written by run_bench.py / ecosystem_bench.py
# (default: benchmarks/data).
# ZARRPATCH_BENCH_DATA=/path/to/fast/disk/zarrpatch_data

# Add any dataset paths your own local benchmarks need here.
